@import '~@/assets/styles/mixins'
@import '~@/assets/styles/variables'

.bug
  display: inline-block
  margin: 0
  width: 30px
  position: relative
  top: 4px
  left: 4px
  height: 30px
  border: 0
  outline: 0
  background: transparent
  cursor: ne-resize
  overflow: hidden
  text-indent: -1000px
  background-image: url('./assets/bug.png')
  background-size: contain
  background-position: center center
  background-repeat: no-repeat

  +media('xs')
    cursor: nw-resize

  // Painted at all times so the swap never waits on a fetch or decode.
  &::after
    content: ''
    display: block
    position: absolute
    top: 0
    left: 0
    width: 100%
    height: 100%
    background-image: url('./assets/bug-active.png')
    background-size: contain
    background-position: center center
    background-repeat: no-repeat
    opacity: 0

  &.active::after
    opacity: 1

dump_media_cache()
